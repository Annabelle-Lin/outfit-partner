{
  "version": "1.0",
  "rules": [
    {
      "rule_id": "S001",
      "name": "临时偏好-颜色",
      "dimension": "temp_pref_color",
      "condition": { "match": "color_brightness", "temp_pref_key": "color" },
      "weight": 2.0,
      "source": "用户本次偏好"
    },
    {
      "rule_id": "S002",
      "name": "临时偏好-款式",
      "dimension": "temp_pref_style",
      "condition": { "match": "style", "temp_pref_key": "style" },
      "weight": 2.0,
      "source": "用户本次偏好"
    },
    {
      "rule_id": "S003",
      "name": "长期偏好匹配",
      "dimension": "long_term_pref",
      "condition": {
        "match_dimensions": ["category_l2", "color_family", "style", "fit_snug"],
        "use_user_preference_score": true
      },
      "weight": 1.0,
      "source": "用户历史反馈"
    },
    {
      "rule_id": "S004",
      "name": "色彩协调-同色系",
      "dimension": "color_harmony",
      "condition": { "color_relation": "same_family" },
      "weight": 1.0,
      "source": "服装色彩构成理论"
    },
    {
      "rule_id": "S005",
      "name": "色彩协调-邻近色",
      "dimension": "color_harmony",
      "condition": { "color_relation": "adjacent" },
      "weight": 0.8,
      "source": "服装色彩构成理论"
    },
    {
      "rule_id": "S006",
      "name": "色彩协调-对比色",
      "dimension": "color_harmony",
      "condition": { "color_relation": "contrast" },
      "weight": 0.5,
      "source": "服装色彩构成理论"
    },
    {
      "rule_id": "S007",
      "name": "版型比例-上宽下窄",
      "dimension": "fit_ratio",
      "condition": {
        "top_fit_snug": ["宽松", "Oversize"],
        "bottom_fit_silhouette": ["直筒", "紧身"]
      },
      "weight": 1.0,
      "source": "服装造型与版型设计理论"
    },
    {
      "rule_id": "S009",
      "name": "面料季节适配",
      "dimension": "fabric_season",
      "condition": { "match_season": true },
      "weight": 0.5,
      "source": "服装材料学"
    },
    {
      "rule_id": "S010",
      "name": "新鲜度",
      "dimension": "freshness",
      "condition": { "days_since_last_worn_min": 7 },
      "weight": 0.5,
      "source": "胶囊衣橱管理理论"
    },
    {
      "rule_id": "S011",
      "name": "体型适配-优势强化",
      "dimension": "body_fit",
      "condition": { "match_body_shape_advantage": true },
      "weight": 1.0,
      "source": "人体体型服饰适配规则"
    },
    {
      "rule_id": "S012",
      "name": "体型适配-避坑降权",
      "dimension": "body_fit",
      "condition": { "match_body_shape_avoid": true },
      "weight": -1.0,
      "source": "人体体型服饰适配规则"
    },
    {
      "rule_id": "S008",
      "name": "26℃穿衣法-保暖总额契合",
      "dimension": "temperature",
      "condition": { "comfort_temp": 26, "formula": "sum(衣物折算度数) ≈ 26 - 气温", "overheat_penalty": true },
      "weight": 9.0,
      "note": "偏差≤1℃ +9，≤2.5℃ +5，≤4℃ +1，>4℃ -5；穿多超过需求2℃ 额外 -4（宁可略凉不过度保暖）。取代旧的「平均暖度」算法——平均值会被多穿稀释，求和不会。",
      "source": "26℃穿衣法（民间经验公式）+ 用户反馈偏好"
    },
    {
      "rule_id": "S013",
      "name": "洋葱式分层叠穿",
      "dimension": "layering",
      "condition": { "min_layers": 2, "layers": ["inner", "middle", "outer"] },
      "weight": 2.0,
      "note": "至少两层（内+外 或 内+中），可按体感增减。",
      "source": "洋葱式穿衣法（中国气象局推荐）"
    },
    {
      "rule_id": "S014",
      "name": "三明治穿法-三层齐全",
      "dimension": "layering",
      "condition": { "require_layers": ["inner", "middle", "outer"] },
      "weight": 1.5,
      "note": "内层贴身透气、中层保暖、外层防风防水；湿冷/雨天尤其合适。雨天内外两层也加分。",
      "source": "三明治穿衣法（中国气象局推荐）"
    }
  ]
}
