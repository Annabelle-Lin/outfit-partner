{
  "version": "1.0",
  "rules": [
    {
      "rule_id": "F001",
      "name": "低温禁短装",
      "dimension": "temperature",
      "condition": {
        "temp_max": 5,
        "forbid_category_l2": ["短裤", "短袖", "吊带", "背心", "凉鞋", "薄裙"]
      },
      "source": "服装材料学·保暖性"
    },
    {
      "rule_id": "F002",
      "name": "高温禁厚装",
      "dimension": "temperature",
      "condition": {
        "temp_min": 28,
        "forbid_category_l2": ["羽绒服", "棉服", "大衣", "厚毛衣"]
      },
      "source": "服装材料学·透气性"
    },
    {
      "rule_id": "F003",
      "name": "正式场合禁休闲",
      "dimension": "occasion",
      "condition": {
        "occasion": ["面试", "正式"],
        "forbid_category_l2": ["运动裤", "拖鞋", "背心", "短裤", "卫衣"]
      },
      "source": "场景着装礼仪规范"
    },
    {
      "rule_id": "F004",
      "name": "运动场合禁正装",
      "dimension": "occasion",
      "condition": {
        "occasion": ["运动"],
        "forbid_category_l2": ["皮鞋", "西装外套", "衬衫"]
      },
      "source": "场景着装礼仪规范"
    },
    {
      "rule_id": "F005",
      "name": "三色原则",
      "dimension": "color",
      "condition": {
        "max_main_colors": 3,
        "exclude_category_l1": ["配饰"]
      },
      "source": "服装色彩构成理论"
    },
    {
      "rule_id": "F006",
      "name": "品类完整性",
      "dimension": "completeness",
      "condition": {
        "require_any": [
          ["上装", "下装", "鞋"],
          ["连衣裙", "鞋"]
        ]
      },
      "source": "胶囊衣橱管理理论"
    },
    {
      "rule_id": "F007",
      "name": "同单品不重复",
      "dimension": "uniqueness",
      "condition": { "no_duplicate_item": true },
      "source": "系统基础规则"
    },
    {
      "rule_id": "F008",
      "name": "用户排除色",
      "dimension": "constraint",
      "condition": { "exclude_color_from_session": true },
      "source": "用户对话约束"
    },
    {
      "rule_id": "F009",
      "name": "26℃穿衣法-保暖总额上限",
      "dimension": "temperature",
      "condition": { "comfort_temp": 26, "max_degrees_over_need": 4, "counted_categories": ["上装", "外套", "连衣裙", "围巾"] },
      "note": "衣物折算度数总和 = 26 - 气温。超出 4℃ 判为明显穿多，直接淘汰。折算表：暖度1→1℃/2→2℃/3→4℃/4→6℃/5→9℃；围巾按名字识别固定 3℃。",
      "source": "26℃穿衣法（民间经验公式，舒适度参考中国气象局18-25℃结论）"
    },
    {
      "rule_id": "F010",
      "name": "26℃穿衣法-保暖总额下限",
      "dimension": "temperature",
      "condition": { "min_degrees_below_need": 5 },
      "note": "折算度数低于需求 5℃ 判为明显穿少，淘汰。",
      "source": "26℃穿衣法"
    },
    {
      "rule_id": "F011",
      "name": "高温清凉夏装",
      "dimension": "temperature",
      "condition": { "temp_gt": 26, "max_single_degrees": 2 },
      "note": "气温高于 26℃ 时上身只能用折算 ≤2℃ 的薄款，针织衫/毛衣/大衣/羽绒服不合规。",
      "source": "26℃穿衣法 + 气象部门夏季着装建议"
    },
    {
      "rule_id": "F012",
      "name": "单品级极端错配淘汰",
      "dimension": "temperature",
      "condition": { "max_single_degrees_over_need": 2 },
      "note": "单件折算度数超过总需求 2℃ 以上（如19℃穿羽绒服9℃）直接淘汰整套，避免一件厚衣毁掉搭配。",
      "source": "26℃穿衣法 + 洋葱式分层原则"
    },
    {
      "rule_id": "F013",
      "name": "雨天禁凉鞋/拖鞋",
      "dimension": "weather",
      "condition": { "rain_probability_gte": 50, "forbid_sub_category": ["凉鞋", "拖鞋"] },
      "source": "天气适配常识"
    },
    {
      "rule_id": "F014",
      "name": "面料冲突-精致内搭禁硬壳外套",
      "dimension": "fabric",
      "condition": {
        "delicate_inner_fabric": ["真丝", "桑蚕丝", "雪纺", "蕾丝", "缎", "丝", "醋酸"],
        "forbid_outer_keywords": ["冲锋衣", "防风衣", "滑雪服", "硬壳", "机能"],
        "check_categories": ["上装", "连衣裙", "外套"]
      },
      "note": "丝/雪纺内搭配冲锋衣属于材质语言互斥，整组淘汰；围巾等配饰不参与判定。有 fabric 字段时只信字段，避免「丝光棉」误杀。",
      "source": "K-MAT-14（03_服装材料与面料特性知识库.md）· 材质语言一致性（工程化规则）"
    },
    {
      "rule_id": "F015",
      "name": "正式场合正式度下限",
      "dimension": "occasion",
      "condition": { "occasion": ["面试", "正式"], "max_formality_level": 1 },
      "note": "正式度≤1 属运动/居家档，不能进面试或正式场合；比子品类黑名单更通用。缺失值按中性 3 处理。",
      "source": "场景着装礼仪规范"
    },
    {
      "rule_id": "F016",
      "name": "场合语境冲突-正式单品禁强休闲单品",
      "dimension": "occasion",
      "condition": {
        "formal_anchor": { "min_formality_level": 4, "categories": ["上装", "下装", "外套", "连衣裙", "套装", "鞋"] },
        "strong_casual_sub_categories": ["拖鞋", "凉鞋", "洞洞鞋", "卫衣", "运动裤", "短裤", "背心", "吊带", "家居服"]
      },
      "note": "西裤/西装外套等正式单品与拖鞋/卫衣等强休闲单品不能同框，整组淘汰。T恤、运动鞋属可接受 smart casual，不在禁止列。",
      "source": "K-ETQ-04 三大类场合着装规范 + K-ETQ-05 正式度分级（04_场景着装礼仪规范知识库.md）"
    }
  ]
}
