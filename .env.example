# 复制本文件为 .env 后填写。.env 已被 git 忽略，不会提交密钥。
# 注意：不要把真实密钥填在本文件里！本文件会被提交到仓库。

# ===== DeepSeek（文本对话：意图识别 / 知识问答 / 搭配文案）=====
# 在 https://platform.deepseek.com 创建 API key（需先充值，按量计费）
# 留空则对话降级为本地规则 + 知识库检索
DEEPSEEK_API_KEY=
# 可选，默认值如下
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ===== 智谱 GLM-4V（仅拍照识别衣物，DeepSeek 无视觉模型）=====
# 在 https://open.bigmodel.cn 创建 API key（GLM-4V-Flash 免费）
# 留空则拍照识别降级为本地启发式推断
ZHIPU_API_KEY=
